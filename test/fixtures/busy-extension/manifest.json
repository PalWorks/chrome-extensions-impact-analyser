{
  "manifest_version": 3,
  "name": "Self-test: busy extension",
  "version": "1.0.0",
  "description": "Test fixture. Burns about 300 ms of CPU on every page it runs on.",
  "background": {"service_worker": "background.js", "scripts": ["background.js"]},
  "browser_specific_settings": {"gecko": {"id": "busy-extension@self-test.invalid"}},
  "permissions": ["storage"],
  "content_scripts": [
    {"matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_idle"}
  ]
}
